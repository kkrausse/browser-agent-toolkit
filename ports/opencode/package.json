{
  "name": "bat-port-opencode",
  "private": true,
  "type": "module",
  "scripts": {
    "build:native": "sh native/build.sh",
    "build:tui:node": "bun build/build-site.ts --target=node --minify",
    "build:tui:bun": "bun build/build-site.ts --target=bun",
    "demo:core": "bun build/bundle.ts demos/core-hello.ts --target=bun && bun demos/run-bun.ts dist/core-hello.js",
    "test:opentui": "cd vendor/opentui/packages/core && bun test --preload ../../../../build/test-preload.ts --path-ignore-patterns='src/zig/zig-pkg/**'"
  }
}
