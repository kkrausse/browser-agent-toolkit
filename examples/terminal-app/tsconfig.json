{
  "include": ["*.ts", "src/**/*.ts"],
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "Preserve",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "moduleResolution": "Bundler",
    "paths": { "@/*": ["../todo-app/src/*"] },
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  }
}
