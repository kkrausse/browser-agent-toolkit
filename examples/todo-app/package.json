{
  "name": "todo-app-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:editor": "bun prepare.ts",
    "build": "bun --bun vite build",
    "start": "NODE_ENV=production bun server.ts",
    "editor": "bun run prepare:editor && bun run build && bun run start",
    "editor:fake": "EDITOR_FAKE_HOST=1 bun run prepare:editor && bun run build && EDITOR_FAKE_HOST=1 bun run start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kkrausse/browser-agent-toolkit": "workspace:*",
    "@kkrausse/browser-agent-toolkit-react": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "5.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "vite": "7.3.6"
  }
}
