{
  "name": "todo-app-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:editor": "bun prepare.ts",
    "dev": "bunx --bun concurrently -k -n vite,api 'react-router dev' 'bun --hot server.ts'",
    "build": "bun --bun react-router build",
    "start": "NODE_ENV=production bun server.ts",
    "preview": "bun run build && SERVE_BUILD=1 bun server.ts",
    "typecheck": "bun --bun react-router typegen && tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@kev-browser-agent-kit/opencode-chat": "file:../../opencode-chat/dist",
    "@kev-browser-agent-kit/workspace": "file:../../workspace-api/dist/lib",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.90.2",
    "@trpc/client": "^11.6.0",
    "@trpc/react-query": "^11.6.0",
    "@trpc/server": "^11.6.0",
    "@trpc/tanstack-react-query": "^11.6.0",
    "tailwindcss": "^4.1.13",
    "valibot": "^1.1.0",
    "vite-tsconfig-paths": "^6.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.13.0"
  },
  "devDependencies": {
    "@react-router/dev": "^7.13.0",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
