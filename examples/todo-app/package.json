{
  "name": "todo-app-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:editor": "bun prepare.ts",
    "build": "bun --bun react-router build",
    "start": "NODE_ENV=production bun server.ts",
    "editor": "bun run prepare:editor && bun run build && bun run start",
    "editor:fake": "EDITOR_FAKE_HOST=1 bun run prepare:editor && bun run build && EDITOR_FAKE_HOST=1 bun run start",
    "typecheck": "bun --bun react-router typegen && tsc --noEmit"
  },
  "dependencies": {
    "@kkrausse/browser-agent-toolkit": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "^5.90.2",
    "@trpc/client": "^11.6.0",
    "@trpc/react-query": "^11.6.0",
    "@trpc/server": "^11.6.0",
    "@trpc/tanstack-react-query": "^11.6.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "7.18.3",
    "tailwindcss": "4.3.3",
    "valibot": "^1.1.0",
    "vite-tsconfig-paths": "^6.1.0"
  },
  "devDependencies": {
    "@react-router/dev": "7.18.3",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "7.3.6"
  }
}
