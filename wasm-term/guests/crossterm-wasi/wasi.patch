diff --git a/Cargo.toml b/Cargo.toml
index a3755ce..6e1ea84 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -44,7 +44,7 @@ derive-more = ["dep:derive_more"]
 document-features = ["dep:document-features"]
 
 ## Enables the [EventStream](event::EventStream) struct for async event reading.
-event-stream = ["dep:futures-core", "events"]
+event-stream = ["dep:futures-core", "events", "dep:tokio"]
 
 ## Enables [`serde`] for various types.
 serde = ["dep:serde", "bitflags/serde"]
@@ -80,6 +80,14 @@ rustix = { version = "1", default-features = false, features = ["std", "stdio",
 signal-hook = { version = "0.3.17", optional = true }
 signal-hook-mio = { version = "0.2.4", features = ["support-v1_0"], optional = true }
 
+# wasm-term (wasm32-wasip1): termios, signals and poll come from the wasm-term
+# guest ABI; rustix covers plain descriptor work. See src/wasi_compat.rs.
+[target.'cfg(target_os = "wasi")'.dependencies]
+rustix = { version = "1", default-features = false, features = ["std", "stdio", "termios"] }
+wasm-term-sys = { path = "../../wasm-term-sys" }
+# Only for `event-stream`: the stream waits on tokio's reactor (see src/event/stream_wasi.rs).
+tokio = { version = "1.44", default-features = false, features = ["net", "rt"], optional = true }
+
 [dev-dependencies]
 futures = "0.3"
 futures-timer = "3.0"
