         #[cfg(target_os = "wasi")]
-        let in_flight = {
-            let _ = (builder, version);
+        let fetch_in_flight = if super::wasi::native_transport() {
+            None
+        } else {
             let mut wire_headers = headers.clone();
             #[cfg(feature = "cookies")]
             if let Some(store) = self.inner.cookie_store.as_ref() {
@@ -2624,18 +2628,27 @@ impl Client {
                     }
                 }
             }
-            ResponseFuture::Wasi(super::wasi::send(method.clone(), url.clone(), wire_headers, body))
+            Some(wire_headers)
         };
         #[cfg(not(target_os = "wasi"))]
-        let in_flight = match version {
