@@ -25,6 +25,7 @@
 //!   host it allows. Unset: the URL is fetched as it is, which only works for
 //!   servers that answer the browser's CORS checks.
 
+use std::sync::atomic::{AtomicBool, Ordering};
 use std::future::Future;
 use std::io;
 use std::pin::Pin;
@@ -38,6 +39,21 @@ use url::Url;
 
 use super::body::{Body, ResponseBody};
 
+static NATIVE_TRANSPORT: AtomicBool = AtomicBool::new(false);
+
+/// Chooses how requests leave on WASI: `false` (the default), through the host's `fetch` as
+/// described above; `true`, through this crate's ordinary hyper + rustls stack over TCP, which
+/// needs tokio's `TcpStream::connect` to work (the port's tokio fork, with a connector
+/// installed). Then nothing in this module is used: headers, bodies, cookies, redirects,
+/// HTTP/2 and TLS are exactly as on a native target, and `WASM_TERM_HTTP_RELAY` is ignored.
+pub fn use_native_transport(native: bool) {
+    NATIVE_TRANSPORT.store(native, Ordering::Relaxed);
+}
+
+pub(super) fn native_transport() -> bool {
+    NATIVE_TRANSPORT.load(Ordering::Relaxed)
+}
+
 /// Prefix under which headers a browser will not send or show travel to and from the relay.
 const FORWARD_PREFIX: &str = "x-wasm-term-fwd-";
 
