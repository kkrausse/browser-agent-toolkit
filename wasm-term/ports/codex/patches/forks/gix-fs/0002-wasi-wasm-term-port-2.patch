From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: port <port@local>
Date: Fri, 9 Oct 2026 22:21:34 -0700
Subject: [PATCH] wasi: wasm-term port (2)

---
 src/symlink.rs | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/src/symlink.rs b/src/symlink.rs
index e75b78a..5cce17d 100644
--- a/src/symlink.rs
+++ b/src/symlink.rs
@@ -11,7 +11,9 @@ pub fn create(original: &Path, link: &Path) -> io::Result<()> {
 /// Create a new symlink at `link` which points to `original` (wasm-term port: WASI).
 #[cfg(target_os = "wasi")]
 pub fn create(original: &Path, link: &Path) -> io::Result<()> {
-    std::os::wasi::fs::symlink_path(original, link)
+    // `std::os::wasi::fs::symlink_path` is unstable; go without symlinks.
+    let _ = (original, link);
+    Err(io::Error::new(io::ErrorKind::Unsupported, "symlinks are not supported on wasm32-wasip1"))
 }
 
 /// Remove a symlink.
