 }
 
 impl TcpListener {
+    /// wasm-term port: WASI preview1 cannot open sockets.
+    #[cfg(all(target_os = "wasi", target_env = "p1"))]
+    pub async fn bind<A: crate::net::ToSocketAddrs>(_addr: A) -> io::Result<TcpListener> {
+        Err(io::Error::new(
+            io::ErrorKind::Unsupported,
+            "TCP listeners are not available on wasm32-wasip1",
+        ))
+    }
+
     cfg_not_wasip1! {
