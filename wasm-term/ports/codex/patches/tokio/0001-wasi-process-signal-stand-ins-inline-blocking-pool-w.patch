+//! Stand-ins for the parts of tokio that have no WASI preview1 backend.
+//! Part of the wasm-term port; not upstream tokio.
+
+#[cfg(feature = "process")]
+pub mod process;
+#[cfg(feature = "signal")]
+pub mod signal;
diff --git a/src/wasi_stubs/process.rs b/src/wasi_stubs/process.rs
new file mode 100644
index 0000000..f11dc1a
--- /dev/null
+++ b/src/wasi_stubs/process.rs
@@ -0,0 +1,263 @@
+//! `tokio::process` for `wasm32-wasip1`: the API surface, with no way to
+//! start a process. WASI preview1 has no fork/exec, and `std::process` on the
+//! target fails every spawn with `ErrorKind::Unsupported`; this module does
+//! the same so that crates written against `tokio::process` keep compiling and
+//! see an ordinary I/O error at run time.
+
+use crate::io::{AsyncRead, AsyncWrite, ReadBuf};
+use std::ffi::OsStr;
+use std::future::Future;
+use std::io;
+use std::path::Path;
+use std::pin::Pin;
+use std::process::{Command as StdCommand, ExitStatus, Output, Stdio};
+use std::task::{Context, Poll};
+
+fn unsupported<T>() -> io::Result<T> {
+    Err(io::Error::new(
+        io::ErrorKind::Unsupported,
+        "processes cannot be spawned on this target (wasm32-wasip1)",
+    ))
+}
+
+/// See the native `tokio::process::Command`.
+#[derive(Debug)]
+pub struct Command {
+    std: StdCommand,
+    kill_on_drop: bool,
+}
+
+impl Command {
+    /// Constructs a new `Command` for launching `program`.
+    pub fn new<S: AsRef<OsStr>>(program: S) -> Command {
+        Command {
+            std: StdCommand::new(program),
+            kill_on_drop: false,
+        }
+    }
+
+    /// Borrows the underlying `std::process::Command`.
+    pub fn as_std(&self) -> &StdCommand {
+        &self.std
+    }
+
+    /// Mutably borrows the underlying `std::process::Command`.
+    pub fn as_std_mut(&mut self) -> &mut StdCommand {
+        &mut self.std
+    }
+
+    /// Unwraps the underlying `std::process::Command`.
+    pub fn into_std(self) -> StdCommand {
+        self.std
+    }
+
+    /// Adds an argument.
+    pub fn arg<S: AsRef<OsStr>>(&mut self, arg: S) -> &mut Command {
+        self.std.arg(arg);
+        self
+    }
+
+    /// Adds arguments.
+    pub fn args<I, S>(&mut self, args: I) -> &mut Command
+    where
+        I: IntoIterator<Item = S>,
+        S: AsRef<OsStr>,
+    {
+        self.std.args(args);
+        self
+    }
+
+    /// Sets an environment variable.
+    pub fn env<K, V>(&mut self, key: K, val: V) -> &mut Command
+    where
+        K: AsRef<OsStr>,
+        V: AsRef<OsStr>,
+    {
+        self.std.env(key, val);
+        self
+    }
+
+    /// Sets environment variables.
+    pub fn envs<I, K, V>(&mut self, vars: I) -> &mut Command
+    where
+        I: IntoIterator<Item = (K, V)>,
+        K: AsRef<OsStr>,
+        V: AsRef<OsStr>,
+    {
+        self.std.envs(vars);
+        self
+    }
+
+    /// Removes an environment variable.
+    pub fn env_remove<K: AsRef<OsStr>>(&mut self, key: K) -> &mut Command {
+        self.std.env_remove(key);
+        self
+    }
+
+    /// Clears the environment.
+    pub fn env_clear(&mut self) -> &mut Command {
+        self.std.env_clear();
+        self
+    }
+
+    /// Sets the working directory.
+    pub fn current_dir<P: AsRef<Path>>(&mut self, dir: P) -> &mut Command {
+        self.std.current_dir(dir);
+        self
+    }
+
+    /// Configures stdin.
+    pub fn stdin<T: Into<Stdio>>(&mut self, cfg: T) -> &mut Command {
+        self.std.stdin(cfg);
+        self
+    }
+
+    /// Configures stdout.
+    pub fn stdout<T: Into<Stdio>>(&mut self, cfg: T) -> &mut Command {
+        self.std.stdout(cfg);
+        self
+    }
+
+    /// Configures stderr.
+    pub fn stderr<T: Into<Stdio>>(&mut self, cfg: T) -> &mut Command {
+        self.std.stderr(cfg);
+        self
+    }
+
+    /// Records the kill-on-drop preference (no effect: nothing can be spawned).
+    pub fn kill_on_drop(&mut self, kill_on_drop: bool) -> &mut Command {
+        self.kill_on_drop = kill_on_drop;
+        self
+    }
+
+    /// Returns the kill-on-drop preference.
+    pub fn get_kill_on_drop(&self) -> bool {
+        self.kill_on_drop
+    }
+
+    /// Always fails with `ErrorKind::Unsupported`.
+    pub fn spawn(&mut self) -> io::Result<Child> {
+        unsupported()
+    }
+
+    /// Always fails with `ErrorKind::Unsupported`.
+    pub fn status(&mut self) -> impl Future<Output = io::Result<ExitStatus>> {
+        std::future::ready(unsupported())
+    }
+
+    /// Always fails with `ErrorKind::Unsupported`.
+    pub fn output(&mut self) -> impl Future<Output = io::Result<Output>> {
+        std::future::ready(unsupported())
+    }
+}
+
+impl From<StdCommand> for Command {
+    fn from(std: StdCommand) -> Command {
+        Command {
+            std,
+            kill_on_drop: false,
+        }
+    }
+}
+
+/// See the native `tokio::process::Child`. Never constructed on this target.
+#[derive(Debug)]
+pub struct Child {
+    /// The child's stdin, if piped.
+    pub stdin: Option<ChildStdin>,
+    /// The child's stdout, if piped.
+    pub stdout: Option<ChildStdout>,
+    /// The child's stderr, if piped.
+    pub stderr: Option<ChildStderr>,
+}
+
+impl Child {
+    /// The OS process id.
+    pub fn id(&self) -> Option<u32> {
+        None
+    }
+
+    /// Starts killing the child.
+    pub fn start_kill(&mut self) -> io::Result<()> {
+        unsupported()
+    }
+
+    /// Kills the child and waits for it.
+    pub async fn kill(&mut self) -> io::Result<()> {
+        unsupported()
+    }
+
+    /// Waits for the child to exit.
+    pub async fn wait(&mut self) -> io::Result<ExitStatus> {
+        unsupported()
+    }
+
+    /// Checks whether the child has exited.
+    pub fn try_wait(&mut self) -> io::Result<Option<ExitStatus>> {
+        unsupported()
+    }
+
+    /// Waits for the child and collects its output.
+    pub async fn wait_with_output(self) -> io::Result<Output> {
+        unsupported()
+    }
+}
+
+macro_rules! child_pipe {
+    ($name:ident) => {
+        /// A child process pipe. Never constructed on this target.
+        #[derive(Debug)]
+        pub struct $name {
+            _private: (),
+        }
+
+        impl $name {
+            /// Always fails with `ErrorKind::Unsupported`.
+            pub fn from_std(_inner: std::process::$name) -> io::Result<Self> {
+                unsupported()
+            }
+        }
+    };
+}
+
+child_pipe!(ChildStdin);
+child_pipe!(ChildStdout);
+child_pipe!(ChildStderr);
+
+impl AsyncWrite for ChildStdin {
+    fn poll_write(
+        self: Pin<&mut Self>,
+        _cx: &mut Context<'_>,
+        _buf: &[u8],
+    ) -> Poll<io::Result<usize>> {
+        Poll::Ready(unsupported())
+    }
+
+    fn poll_flush(self: Pin<&mut Self>, _cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+        Poll::Ready(Ok(()))
+    }
+
+    fn poll_shutdown(self: Pin<&mut Self>, _cx: &mut Context<'_>) -> Poll<io::Result<()>> {
+        Poll::Ready(Ok(()))
+    }
+}
+
+impl AsyncRead for ChildStdout {
+    fn poll_read(
+        self: Pin<&mut Self>,
+        _cx: &mut Context<'_>,
+        _buf: &mut ReadBuf<'_>,
+    ) -> Poll<io::Result<()>> {
+        Poll::Ready(Ok(()))
+    }
+}
+
+impl AsyncRead for ChildStderr {
+    fn poll_read(
+        self: Pin<&mut Self>,
+        _cx: &mut Context<'_>,
+        _buf: &mut ReadBuf<'_>,
+    ) -> Poll<io::Result<()>> {
+        Poll::Ready(Ok(()))
+    }
+}
diff --git a/src/wasi_stubs/signal.rs b/src/wasi_stubs/signal.rs
new file mode 100644
index 0000000..88edbc3
--- /dev/null
+++ b/src/wasi_stubs/signal.rs
@@ -0,0 +1,10 @@
+//! `tokio::signal` for `wasm32-wasip1`: there are no asynchronous signals, so
+//! `ctrl_c` never completes. (Terminal signals reach a wasm-term guest through
+//! a signalfd-style descriptor instead; see the crossterm WASI backend.)
+
+use std::io;
+
+/// Completes when Ctrl-C is delivered to the process: never, on this target.
+pub async fn ctrl_c() -> io::Result<()> {
+    std::future::pending().await
+}
