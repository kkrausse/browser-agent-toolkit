 }
 
 impl TcpStream {
-    /// wasm-term port: WASI preview1 cannot open sockets; fail like an
-    /// unreachable network so callers written against the native API compile.
+    /// wasm-term port: WASI preview1 cannot open sockets. A program whose host can carry a
+    /// TCP stream some other way installs a connector (`net::set_wasi_tcp_connector`), and
+    /// this hands it the destination by name: there is no resolver here either. Without a
+    /// connector it fails like an unreachable network, so callers written against the native
+    /// API compile and get an error they already handle.
     #[cfg(all(target_os = "wasi", target_env = "p1"))]
-    pub async fn connect<A: crate::net::ToSocketAddrs>(_addr: A) -> io::Result<TcpStream> {
-        Err(io::Error::new(
-            io::ErrorKind::Unsupported,
-            "TCP connections are not available on wasm32-wasip1",
-        ))
+    pub async fn connect<A: crate::net::ToSocketAddrs>(addr: A) -> io::Result<TcpStream> {
+        let destination = crate::net::addr::sealed::ToSocketAddrsPriv::wasi_host_port(&addr);
+        match (crate::wasi_stubs::net::tcp_connector(), destination) {
+            (Some(connector), Some((host, port))) => connector(host, port).await,
+            (Some(_), None) => Err(io::Error::new(
+                io::ErrorKind::InvalidInput,
+                "TcpStream::connect on wasm32-wasip1 takes one host and port",
+            )),
+            (None, _) => Err(io::Error::new(
+                io::ErrorKind::Unsupported,
+                "TCP connections are not available on wasm32-wasip1",
+            )),
+        }
     }
 
     cfg_not_wasip1! {
diff --git a/src/wasi_stubs/net.rs b/src/wasi_stubs/net.rs
index 367dd2e..35aa400 100644
--- a/src/wasi_stubs/net.rs
+++ b/src/wasi_stubs/net.rs
@@ -11,6 +11,29 @@ use std::os::fd::{AsFd, AsRawFd, BorrowedFd, FromRawFd, IntoRawFd, RawFd};
 use std::task::{Context, Poll};
 use std::time::Duration;
 
+/// Opens a TCP stream to a host name (or address literal) and port: what
+/// `TcpStream::connect` calls on this target once a program has installed one.
+pub type WasiTcpConnector =
+    fn(String, u16) -> std::pin::Pin<Box<dyn std::future::Future<Output = io::Result<TcpStream>> + Send>>;
+
+static TCP_CONNECTOR: std::sync::OnceLock<WasiTcpConnector> = std::sync::OnceLock::new();
+
+/// Installs the connector behind `TcpStream::connect`. The first call wins. The stream it
+/// returns is an ordinary `TcpStream` (`from_std` on a descriptor that reads, writes and
+/// polls like a socket). Only a program that calls this links a connector in at all.
+pub fn set_wasi_tcp_connector(connector: WasiTcpConnector) {
+    let _ = TCP_CONNECTOR.set(connector);
+}
+
+/// Whether `TcpStream::connect` can work at all: a connector is installed.
+pub fn wasi_tcp_available() -> bool {
+    TCP_CONNECTOR.get().is_some()
+}
+
+pub(crate) fn tcp_connector() -> Option<WasiTcpConnector> {
+    TCP_CONNECTOR.get().copied()
+}
+
 fn unsupported() -> io::Error {
     io::Error::new(
         io::ErrorKind::Unsupported,
