diff --git a/Cargo.toml b/Cargo.toml
index a3755ce..33c07aa 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -69,6 +69,11 @@ serde = { version = "1.0.103", features = ["derive"], optional = true }
 crossterm_winapi = { version = "0.9.1", optional = true }
 winapi = { version = "0.3.9", optional = true, features = ["winuser", "winerror"] }
 
+# WASI (wasm-term guest ABI): no mio/signal-hook; termios, signals and polling
+# go through src/wasi_compat.rs.
+[target.'cfg(target_os = "wasi")'.dependencies]
+rustix = { version = "1", default-features = false, features = ["std", "stdio"] }
+
 # UNIX dependencies
 [target.'cfg(unix)'.dependencies]
 filedescriptor = { version = "0.8", optional = true }
