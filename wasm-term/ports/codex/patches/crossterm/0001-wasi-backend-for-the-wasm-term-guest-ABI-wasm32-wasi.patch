+//! Backend for `wasm32-wasip1` guests of the wasm-term emulated machine.
+//!
+//! WASI preview1 has no termios, no signals and no `mio` selector with a waker.
+//! Rather than fork every unix code path, this module offers the small slices
+//! of `rustix`, `mio`, `signal-hook` and `signal-hook-mio` that crossterm's
+//! unix implementation uses, with the same names and shapes, implemented on:
+//!
+//! - the `wasm_term` import module (termios, window size, signalfd-style
+//!   descriptor), see `wasm-term/docs/abi.md` and `guests/wasm-term-sys`;
+//! - `wasi_snapshot_preview1::poll_oneoff` for readiness and timeouts.
+//!
+//! The unix modules pull these in with `use crate::wasi_compat::{mio, ...}` /
+//! `use crate::wasi_compat as rustix`, so their bodies stay untouched.
+//!
+//! There are no threads on plain `wasm32-wasip1`, so [`EventStream`] cannot
+//! park a helper thread in `poll`. Instead it records the task waker here and
+//! the embedder calls [`notify_input_ready`] when one of [`input_fds`] becomes
+//! readable in its own reactor (for codex: tokio's WASI I/O driver).
+//!
+//! [`EventStream`]: crate::event::EventStream
+
+use std::io as stdio_err;
+use std::os::fd::RawFd;
+use std::sync::Mutex;
+use std::sync::atomic::{AtomicI32, Ordering};
+use std::time::Duration;
+
+mod raw {
+    #[link(wasm_import_module = "wasm_term")]
+    unsafe extern "C" {
+        pub fn tcgetattr(fd: u32, termios: *mut super::termios::Termios) -> u32;
+        pub fn tcsetattr(fd: u32, action: u32, termios: *const super::termios::Termios) -> u32;
+        pub fn winsize_get(fd: u32, winsize: *mut super::termios::Winsize) -> u32;
+        pub fn sig_action(signo: u32, action: u32, old_action: *mut u32) -> u32;
+        pub fn sig_fd(fd: *mut u32) -> u32;
+    }
+
+    #[link(wasm_import_module = "wasi_snapshot_preview1")]
+    unsafe extern "C" {
+        pub fn poll_oneoff(subs: *const u8, events: *mut u8, count: u32, nevents: *mut u32) -> u32;
+        pub fn fd_fdstat_set_flags(fd: u32, flags: u32) -> u32;
+    }
+}
+
+fn check(errno: u32) -> stdio_err::Result<()> {
+    if errno == 0 {
+        Ok(())
+    } else {
+        Err(stdio_err::Error::from_raw_os_error(errno as i32))
+    }
+}
+
+const SUBSCRIPTION_SIZE: usize = 48;
+const EVENT_SIZE: usize = 32;
+const TIMEOUT_USERDATA: u64 = u64::MAX;
+
+/// `poll_oneoff` for readability of `fds` with an optional timeout. Returns
+/// the indexes that are readable (empty = timed out).
+fn poll_readable(fds: &[RawFd], timeout: Option<Duration>) -> stdio_err::Result<Vec<usize>> {
+    let count = fds.len() + usize::from(timeout.is_some());
+    if count == 0 {
+        return Err(stdio_err::Error::new(
+            stdio_err::ErrorKind::InvalidInput,
+            "poll: nothing to wait for",
+        ));
+    }
+    let mut subs = vec![0u8; count * SUBSCRIPTION_SIZE];
+    for (index, fd) in fds.iter().enumerate() {
+        let sub = &mut subs[index * SUBSCRIPTION_SIZE..];
+        sub[0..8].copy_from_slice(&(index as u64).to_le_bytes());
+        sub[8] = 1; // EVENTTYPE_FD_READ
+        sub[16..20].copy_from_slice(&(*fd as u32).to_le_bytes());
+    }
+    if let Some(timeout) = timeout {
+        let sub = &mut subs[fds.len() * SUBSCRIPTION_SIZE..];
+        sub[0..8].copy_from_slice(&TIMEOUT_USERDATA.to_le_bytes());
+        sub[8] = 0; // EVENTTYPE_CLOCK
+        sub[16..20].copy_from_slice(&1u32.to_le_bytes()); // CLOCKID_MONOTONIC
+        let nanos = u64::try_from(timeout.as_nanos()).unwrap_or(u64::MAX);
+        sub[24..32].copy_from_slice(&nanos.to_le_bytes());
+    }
+    let mut events = vec![0u8; count * EVENT_SIZE];
+    let mut nevents = 0u32;
+    check(unsafe {
+        raw::poll_oneoff(
+            subs.as_ptr(),
+            events.as_mut_ptr(),
+            count as u32,
+            &mut nevents,
+        )
+    })?;
+    let mut ready = Vec::new();
+    for event in events.chunks_exact(EVENT_SIZE).take(nevents as usize) {
+        let userdata = u64::from_le_bytes(event[0..8].try_into().unwrap());
+        if userdata != TIMEOUT_USERDATA {
+            ready.push(userdata as usize);
+        }
+    }
+    Ok(ready)
+}
+
+// ---------------------------------------------------------------------------
+// Embedder hooks for EventStream (no helper thread on wasm32-wasip1).
+
+static TTY_FD: AtomicI32 = AtomicI32::new(-1);
+static SIGNAL_FD: AtomicI32 = AtomicI32::new(-1);
+static STREAM_WAKER: Mutex<Option<std::task::Waker>> = Mutex::new(None);
+
+/// Descriptors whose readability means terminal events may be available:
+/// the terminal input and the signal descriptor (SIGWINCH). `None` until the
+/// event reader has been created (first `poll`/`read`/`EventStream`).
+pub fn input_fds() -> Option<[RawFd; 2]> {
+    let tty = TTY_FD.load(Ordering::SeqCst);
+    let signal = SIGNAL_FD.load(Ordering::SeqCst);
+    (tty >= 0 && signal >= 0).then_some([tty, signal])
+}
+
+/// Wakes the task parked in `EventStream::poll_next`, if any. Call this when
+/// one of [`input_fds`] is readable, or after a deadline returned by
+/// [`crate::event::poll`]-style escape timeouts may have passed.
+pub fn notify_input_ready() {
+    if let Some(waker) = STREAM_WAKER.lock().unwrap().take() {
+        waker.wake();
+    }
+}
+
+pub(crate) fn park_stream_waker(waker: &std::task::Waker) {
+    *STREAM_WAKER.lock().unwrap() = Some(waker.clone());
+}
+
+// ---------------------------------------------------------------------------
+// rustix look-alikes: `use crate::wasi_compat as rustix;`
+
+pub use ::rustix::fd;
+pub use ::rustix::stdio;
+
+pub mod io {
+    pub use ::rustix::io::read;
+    use std::os::fd::{AsFd, AsRawFd};
+
+    /// Stand-in for `FIONREAD`: only ever compared with zero by crossterm, so
+    /// report 1 when the descriptor is readable right now and 0 otherwise.
+    pub fn ioctl_fionread(fd: impl AsFd) -> std::io::Result<u64> {
+        let fd = fd.as_fd().as_raw_fd();
+        let ready = super::poll_readable(&[fd], Some(std::time::Duration::ZERO))?;
+        Ok(u64::from(!ready.is_empty()))
+    }
+}
+
+pub mod termios {
+    use super::{check, raw};
+    use std::io;
+    use std::os::fd::{AsFd, AsRawFd};
+
+    const NCCS: usize = 20;
+
+    /// Linux `struct termios` without `c_line`, as the wasm-term ABI defines it.
+    #[repr(C)]
+    #[derive(Clone, Copy, Debug, PartialEq, Eq)]
+    pub struct Termios {
+        pub c_iflag: u32,
+        pub c_oflag: u32,
+        pub c_cflag: u32,
+        pub c_lflag: u32,
+        pub c_cc: [u8; NCCS],
+        pub c_ispeed: u32,
+        pub c_ospeed: u32,
+    }
+
+    impl Termios {
+        /// `cfmakeraw(3)`.
+        pub fn make_raw(&mut self) {
+            const IGNBRK: u32 = 0o1;
+            const BRKINT: u32 = 0o2;
+            const PARMRK: u32 = 0o10;
+            const ISTRIP: u32 = 0o40;
+            const INLCR: u32 = 0o100;
+            const IGNCR: u32 = 0o200;
+            const ICRNL: u32 = 0o400;
+            const IXON: u32 = 0o2000;
+            const OPOST: u32 = 0o1;
+            const CSIZE: u32 = 0o60;
+            const CS8: u32 = 0o60;
+            const PARENB: u32 = 0o400;
+            const ISIG: u32 = 0o1;
+            const ICANON: u32 = 0o2;
+            const ECHO: u32 = 0o10;
+            const ECHONL: u32 = 0o100;
+            const IEXTEN: u32 = 0o100000;
+            const VTIME: usize = 5;
+            const VMIN: usize = 6;
+            self.c_iflag &= !(IGNBRK | BRKINT | PARMRK | ISTRIP | INLCR | IGNCR | ICRNL | IXON);
+            self.c_oflag &= !OPOST;
+            self.c_lflag &= !(ECHO | ECHONL | ICANON | ISIG | IEXTEN);
+            self.c_cflag &= !(CSIZE | PARENB);
+            self.c_cflag |= CS8;
+            self.c_cc[VMIN] = 1;
+            self.c_cc[VTIME] = 0;
+        }
+    }
+
+    #[repr(C)]
+    #[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+    pub struct Winsize {
+        pub ws_row: u16,
+        pub ws_col: u16,
+        pub ws_xpixel: u16,
+        pub ws_ypixel: u16,
+    }
+
+    #[derive(Clone, Copy, Debug)]
+    #[repr(u32)]
+    pub enum OptionalActions {
+        Now = 0,
+        Drain = 1,
+        Flush = 2,
+    }
+
+    pub fn tcgetattr(fd: impl AsFd) -> io::Result<Termios> {
+        let mut termios = std::mem::MaybeUninit::<Termios>::zeroed();
+        check(unsafe { raw::tcgetattr(fd.as_fd().as_raw_fd() as u32, termios.as_mut_ptr()) })?;
+        Ok(unsafe { termios.assume_init() })
+    }
+
+    pub fn tcsetattr(
+        fd: impl AsFd,
+        action: OptionalActions,
+        termios: &Termios,
+    ) -> io::Result<()> {
+        check(unsafe { raw::tcsetattr(fd.as_fd().as_raw_fd() as u32, action as u32, termios) })
+    }
+
+    pub fn tcgetwinsize(fd: impl AsFd) -> io::Result<Winsize> {
+        let mut winsize = Winsize::default();
+        check(unsafe { raw::winsize_get(fd.as_fd().as_raw_fd() as u32, &mut winsize) })?;
+        Ok(winsize)
+    }
+
+    pub fn isatty(fd: impl AsFd) -> bool {
+        tcgetattr(fd).is_ok()
+    }
+}
+
+// ---------------------------------------------------------------------------
+// signal-hook look-alikes.
+
+pub mod signal_hook {
+    pub mod consts {
+        pub const SIGWINCH: i32 = 28;
+    }
+}
+
+pub mod signal_hook_mio {
+    pub mod v1_0 {
+        use crate::wasi_compat::{SIGNAL_FD, check, raw};
+        use std::fs::File;
+        use std::io::{self, Read};
+        use std::os::fd::{AsRawFd, FromRawFd, RawFd};
+        use std::sync::atomic::Ordering;
+
+        const ACTION_CATCH: u32 = 2;
+        const FDFLAGS_NONBLOCK: u32 = 4;
+
+        /// The wasm-term signalfd-style descriptor: one little-endian `u32`
+        /// signal number per caught signal.
+        #[derive(Debug)]
+        pub struct Signals {
+            file: File,
+        }
+
+        impl Signals {
+            pub fn new(signals: impl IntoIterator<Item = i32>) -> io::Result<Signals> {
+                for signo in signals {
+                    let mut old = 0u32;
+                    check(unsafe { raw::sig_action(signo as u32, ACTION_CATCH, &mut old) })?;
+                }
+                let mut fd = 0u32;
+                check(unsafe { raw::sig_fd(&mut fd) })?;
+                check(unsafe { raw::fd_fdstat_set_flags(fd, FDFLAGS_NONBLOCK) })?;
+                SIGNAL_FD.store(fd as RawFd, Ordering::SeqCst);
+                Ok(Signals {
+                    file: unsafe { File::from_raw_fd(fd as RawFd) },
+                })
+            }
+
+            pub fn pending(&mut self) -> std::vec::IntoIter<i32> {
+                let mut buf = [0u8; 64];
+                let signals: Vec<i32> = match self.file.read(&mut buf) {
+                    Ok(n) => buf[..n]
+                        .chunks_exact(4)
+                        .map(|c| u32::from_le_bytes([c[0], c[1], c[2], c[3]]) as i32)
+                        .collect(),
+                    Err(_) => Vec::new(),
+                };
+                signals.into_iter()
+            }
+        }
+
+        impl AsRawFd for Signals {
+            fn as_raw_fd(&self) -> RawFd {
+                self.file.as_raw_fd()
+            }
+        }
+
+        impl crate::wasi_compat::mio::Source for Signals {
+            fn source_fd(&self) -> RawFd {
+                self.as_raw_fd()
+            }
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------
+// mio look-alikes: a registry of (fd, token) pairs polled with poll_oneoff.
+
+pub mod mio {
+    use super::{TTY_FD, poll_readable};
+    use std::io;
+    use std::os::fd::RawFd;
+    use std::sync::atomic::{AtomicBool, Ordering};
+    use std::sync::{Arc, Mutex};
+    use std::time::{Duration, Instant};
+
+    /// With real threads (`wasm32-wasip1-threads`) another thread may call
+    /// `Waker::wake` while this one is blocked in `poll_oneoff`; WASI has no
+    /// pipe to interrupt it with, so the wait is cut into slices.
+    #[cfg(target_feature = "atomics")]
+    const WAKE_SLICE: Option<Duration> = Some(Duration::from_millis(20));
+    #[cfg(not(target_feature = "atomics"))]
+    const WAKE_SLICE: Option<Duration> = None;
+
+    #[derive(Clone, Copy, Debug, PartialEq, Eq)]
+    pub struct Token(pub usize);
+
+    #[derive(Clone, Copy, Debug)]
+    pub struct Interest;
+
+    impl Interest {
+        pub const READABLE: Interest = Interest;
+    }
+
+    pub trait Source {
+        fn source_fd(&self) -> RawFd;
+    }
+
+    pub mod unix {
+        use std::os::fd::RawFd;
+
+        pub struct SourceFd<'a>(pub &'a RawFd);
+
+        impl super::Source for SourceFd<'_> {
+            fn source_fd(&self) -> RawFd {
+                *self.0
+            }
+        }
+    }
+
+    #[derive(Debug, Default)]
+    struct Shared {
+        sources: Mutex<Vec<(RawFd, Token)>>,
+        waker: Mutex<Option<(Arc<AtomicBool>, Token)>>,
+    }
+
+    #[derive(Debug)]
+    pub struct Registry {
+        shared: Arc<Shared>,
+    }
+
+    impl Registry {
+        pub fn register<S: Source + ?Sized>(
+            &self,
+            source: &mut S,
+            token: Token,
+            _interest: Interest,
+        ) -> io::Result<()> {
+            let fd = source.source_fd();
+            let mut sources = self.shared.sources.lock().unwrap();
+            if sources.is_empty() {
+                // crossterm registers the terminal input first.
+                TTY_FD.store(fd, Ordering::SeqCst);
+            }
+            sources.push((fd, token));
+            Ok(())
+        }
+    }
+
+    #[derive(Debug)]
+    pub struct Poll {
+        registry: Registry,
+    }
+
+    impl Poll {
+        pub fn new() -> io::Result<Poll> {
+            Ok(Poll {
+                registry: Registry {
+                    shared: Arc::new(Shared::default()),
+                },
+            })
+        }
+
+        pub fn registry(&self) -> &Registry {
+            &self.registry
+        }
+
+        pub fn poll(&mut self, events: &mut Events, timeout: Option<Duration>) -> io::Result<()> {
+            events.inner.clear();
+            let shared = &self.registry.shared;
+            let sources = shared.sources.lock().unwrap().clone();
+            let fds: Vec<RawFd> = sources.iter().map(|(fd, _)| *fd).collect();
+            let waker = shared.waker.lock().unwrap().clone();
+            let deadline = timeout.map(|timeout| Instant::now() + timeout);
+            loop {
+                if let Some((flag, token)) = &waker {
+                    if flag.swap(false, Ordering::SeqCst) {
+                        events.inner.push(Event { token: *token });
+                        return Ok(());
+                    }
+                }
+                let remaining = deadline.map(|d| d.saturating_duration_since(Instant::now()));
+                let slice = match (remaining, WAKE_SLICE.filter(|_| waker.is_some())) {
+                    (Some(remaining), Some(slice)) => Some(remaining.min(slice)),
+                    (Some(remaining), None) => Some(remaining),
+                    (None, slice) => slice,
+                };
+                let ready = poll_readable(&fds, slice)?;
+                if !ready.is_empty() {
+                    events
+                        .inner
+                        .extend(ready.into_iter().map(|index| Event {
+                            token: sources[index].1,
+                        }));
+                    return Ok(());
+                }
+                if remaining.is_some_and(|remaining| remaining.is_zero())
+                    || deadline.is_some_and(|d| Instant::now() >= d)
+                {
+                    return Ok(());
+                }
+            }
+        }
+    }
+
+    #[derive(Clone, Copy, Debug)]
+    pub struct Event {
+        token: Token,
+    }
+
+    impl Event {
+        pub fn token(&self) -> Token {
+            self.token
+        }
+    }
+
+    #[derive(Debug, Default)]
+    pub struct Events {
+        inner: Vec<Event>,
+    }
+
+    impl Events {
+        pub fn with_capacity(capacity: usize) -> Events {
+            Events {
+                inner: Vec::with_capacity(capacity),
+            }
+        }
+
+        pub fn is_empty(&self) -> bool {
+            self.inner.is_empty()
+        }
+
+        pub fn iter(&self) -> std::slice::Iter<'_, Event> {
+            self.inner.iter()
+        }
+    }
+
+    #[derive(Debug)]
+    pub struct Waker {
+        flag: Arc<AtomicBool>,
+    }
+
+    impl Waker {
+        pub fn new(registry: &Registry, token: Token) -> io::Result<Waker> {
+            let flag = Arc::new(AtomicBool::new(false));
+            *registry.shared.waker.lock().unwrap() = Some((flag.clone(), token));
+            Ok(Waker { flag })
+        }
+
+        pub fn wake(&self) -> io::Result<()> {
+            self.flag.store(true, Ordering::SeqCst);
+            Ok(())
+        }
+    }
+}
