From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: port <port@local>
Date: Fri, 9 Oct 2026 22:52:08 -0700
Subject: [PATCH] wasi: use the guests crossterm-wasi fork

---
 codex-rs/Cargo.lock | 6 ++++++
 codex-rs/Cargo.toml | 5 +++--
 2 files changed, 9 insertions(+), 2 deletions(-)

diff --git a/codex-rs/Cargo.lock b/codex-rs/Cargo.lock
index 8c8b9fc..246763b 100644
--- a/codex-rs/Cargo.lock
+++ b/codex-rs/Cargo.lock
@@ -5841,6 +5841,8 @@ dependencies = [
  "rustix 1.1.4",
  "signal-hook",
  "signal-hook-mio",
+ "tokio",
+ "wasm-term-sys",
  "winapi",
 ]
 
@@ -16724,6 +16726,10 @@ dependencies = [
  "web-sys",
 ]
 
+[[package]]
+name = "wasm-term-sys"
+version = "0.1.0"
+
 [[package]]
 name = "wasmparser"
 version = "0.244.0"
diff --git a/codex-rs/Cargo.toml b/codex-rs/Cargo.toml
index 3dc8e4e..11fffba 100644
--- a/codex-rs/Cargo.toml
+++ b/codex-rs/Cargo.toml
@@ -644,8 +644,9 @@ opt-level = 0
 # Uncomment to debug local changes.
 # ratatui = { path = "../../ratatui" }
 # wasm-term port: local forks under wasm-term/vendor/ (see ports/codex/NOTES.md).
-# crossterm = openai-oss-forks/crossterm@ed1cdab + WASI backend; tokio = 1.52.3 + WASI stand-ins.
-crossterm = { path = "../../crossterm" }
+# crossterm = openai-oss-forks/crossterm@ed1cdab + the WASI backend generated by wasm-term/guests/crossterm-wasi/setup.sh;
+# tokio = 1.52.3 + WASI stand-ins.
+crossterm = { path = "../../../guests/crossterm-wasi/crossterm" }
 tokio = { path = "../../tokio" }
 gethostname = { path = "../../forks/gethostname" }
 gix-fs = { path = "../../forks/gix-fs" }
