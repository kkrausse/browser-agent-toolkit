     }
 }
 
+// wasm-term port: WASI preview1 has no Unix domain sockets. Same shape as the
+// other platforms; every operation reports `Unsupported`.
+#[cfg(target_os = "wasi")]
+mod platform {
+    use std::io;
+    use std::io::Result as IoResult;
+    use std::path::Path;
+
+    pub(super) type Stream = tokio::io::DuplexStream;
+
+    pub(super) struct Listener(());
+
+    fn unsupported<T>() -> IoResult<T> {
+        Err(io::Error::new(
+            io::ErrorKind::Unsupported,
+            "unix domain sockets are not available on wasm32-wasip1",
+        ))
+    }
+
+    pub(super) async fn prepare_private_socket_directory(_socket_dir: &Path) -> IoResult<()> {
+        unsupported()
+    }
+
+    pub(super) async fn bind_listener(_socket_path: &Path) -> IoResult<Listener> {
+        unsupported()
+    }
+
+    impl Listener {
+        pub(super) async fn accept(&mut self) -> IoResult<Stream> {
+            unsupported()
+        }
+    }
+
+    pub(super) async fn connect_stream(_socket_path: &Path) -> IoResult<Stream> {
+        unsupported()
+    }
+
+    pub(super) async fn is_stale_socket_path(_socket_path: &Path) -> IoResult<bool> {
+        Ok(false)
+    }
+}
