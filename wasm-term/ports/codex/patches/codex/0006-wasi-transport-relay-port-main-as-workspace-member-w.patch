+/// wasm-term port: the browser opens the socket (see `remote_wasi.rs`). It cannot
+/// attach an `Authorization` header, so a token is refused rather than dropped.
+#[cfg(target_os = "wasi")]
+async fn connect_websocket_endpoint(
+    websocket_url: String,
+    auth_token: Option<String>,
+) -> IoResult<(String, WebSocketStream<tokio::io::DuplexStream>)> {
+    Url::parse(&websocket_url).map_err(|err| {
+        IoError::new(
+            ErrorKind::InvalidInput,
+            format!("invalid websocket URL `{websocket_url}`: {err}"),
+        )
+    })?;
+    if auth_token.is_some() {
+        return Err(IoError::new(
+            ErrorKind::InvalidInput,
+            "remote auth tokens cannot be sent from a browser WebSocket; authenticate at the proxy in front of the app server",
+        ));
+    }
+    let stream = crate::remote_wasi::connect(
+        &websocket_url,
+        remote_websocket_config(),
+        CONNECT_TIMEOUT,
+    )
+    .await?;
+    Ok((websocket_url, stream))
+}
