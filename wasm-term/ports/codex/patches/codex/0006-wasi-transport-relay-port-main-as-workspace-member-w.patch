diff --git a/codex-rs/app-server-client/src/remote_wasi.rs b/codex-rs/app-server-client/src/remote_wasi.rs
new file mode 100644
index 0000000..051c638
--- /dev/null
+++ b/codex-rs/app-server-client/src/remote_wasi.rs
@@ -0,0 +1,141 @@
+//! wasm-term port: the remote app-server connection inside a browser Worker.
+//!
+//! On WASI there is no TCP. The browser owns the WebSocket and the wasm-term
+//! host hands the guest whole messages through a pollable descriptor
+//! (`wasm_term_tokio::WebSocket`). The rest of `remote.rs` is written against
+//! `WebSocketStream<S>`, so instead of re-typing it this module gives it one:
+//! the client end of an in-memory duplex pipe, with a task on the other end
+//! that speaks the server role of the framing and relays each message to and
+//! from the browser socket. No handshake runs on the pipe and nothing in it
+//! reaches the network; it only exists to keep the upstream code unchanged.
+
+use std::io::Error as IoError;
+use std::io::ErrorKind;
+use std::io::Result as IoResult;
+use std::time::Duration;
+
+use futures::SinkExt;
+use futures::StreamExt;
+use tokio::io::DuplexStream;
+use tokio::time::timeout;
+use tokio_tungstenite::WebSocketStream;
+use tokio_tungstenite::tungstenite::Message;
+use tokio_tungstenite::tungstenite::protocol::CloseFrame;
+use tokio_tungstenite::tungstenite::protocol::Role;
+use tokio_tungstenite::tungstenite::protocol::WebSocketConfig;
+use tokio_tungstenite::tungstenite::protocol::frame::coding::CloseCode;
+use wasm_term_tokio::WebSocket;
+use wasm_term_tokio::WsEvent;
+
+/// Bytes of framed data either direction may hold before the writer waits.
+const PIPE_CAPACITY: usize = 4 * 1024 * 1024;
+/// A close frame's reason is limited to 123 bytes by the protocol.
+const MAX_CLOSE_REASON_BYTES: usize = 120;
+
+pub(crate) async fn connect(
+    websocket_url: &str,
+    config: WebSocketConfig,
+    connect_timeout: Duration,
+) -> IoResult<WebSocketStream<DuplexStream>> {
+    let mut socket = WebSocket::connect(websocket_url, &[]).map_err(|err| {
+        IoError::other(format!(
+            "failed to connect to remote app server at `{websocket_url}`: {err}"
+        ))
+    })?;
+    let opened = timeout(connect_timeout, socket.recv()).await.map_err(|_| {
+        IoError::new(
+            ErrorKind::TimedOut,
+            format!("timed out connecting to remote app server at `{websocket_url}`"),
+        )
+    })??;
+    match opened {
+        WsEvent::Open(_) => {}
+        WsEvent::Error(message) => {
+            return Err(IoError::other(format!(
+                "failed to connect to remote app server at `{websocket_url}`: {message}"
+            )));
+        }
+        WsEvent::Close { code, reason } => {
+            return Err(IoError::other(format!(
+                "remote app server at `{websocket_url}` closed the connection during connect: {code} {reason}"
+            )));
+        }
+        WsEvent::Text(_) | WsEvent::Binary(_) => {
+            return Err(IoError::other(format!(
+                "remote app server at `{websocket_url}` sent data before the connection opened"
+            )));
+        }
+    }
+
+    let (client_io, relay_io) = tokio::io::duplex(PIPE_CAPACITY);
+    let client = WebSocketStream::from_raw_socket(client_io, Role::Client, Some(config)).await;
+    let relay = WebSocketStream::from_raw_socket(relay_io, Role::Server, Some(config)).await;
+    tokio::spawn(relay_messages(socket, relay));
+    Ok(client)
+}
+
+fn close_frame(code: CloseCode, reason: &str) -> CloseFrame {
+    let mut end = reason.len().min(MAX_CLOSE_REASON_BYTES);
+    while !reason.is_char_boundary(end) {
+        end -= 1;
+    }
+    CloseFrame {
+        code,
+        reason: reason[..end].to_string().into(),
+    }
+}
+
+async fn relay_messages(mut socket: WebSocket, mut relay: WebSocketStream<DuplexStream>) {
+    loop {
+        tokio::select! {
+            outgoing = relay.next() => match outgoing {
+                Some(Ok(Message::Text(text))) => {
+                    if socket.send_text(text.as_str()).is_err() {
+                        break;
+                    }
+                }
+                Some(Ok(Message::Binary(data))) => {
+                    if socket.send_binary(&data).is_err() {
+                        break;
+                    }
+                }
+                Some(Ok(Message::Close(_))) | Some(Err(_)) | None => {
+                    // Browsers only accept 1000 or 3000-4999 from script.
+                    let _ = socket.close(1000, "");
+                    break;
+                }
+                Some(Ok(Message::Ping(_) | Message::Pong(_) | Message::Frame(_))) => {}
+            },
+            incoming = socket.recv() => {
+                let result = match incoming {
+                    Ok(WsEvent::Text(text)) => relay.send(Message::Text(text.into())).await,
+                    Ok(WsEvent::Binary(data)) => relay.send(Message::Binary(data.into())).await,
+                    Ok(WsEvent::Open(_)) => Ok(()),
+                    Ok(WsEvent::Close { code, reason }) => {
+                        let code = match code {
+                            // Not valid inside a frame; the browser reports them for abnormal ends.
+                            1005 | 1006 | 1015 => CloseCode::Error,
+                            other => CloseCode::from(other),
+                        };
+                        let _ = relay.close(Some(close_frame(code, &reason))).await;
+                        break;
+                    }
+                    Ok(WsEvent::Error(message)) => {
+                        let _ = relay.close(Some(close_frame(CloseCode::Error, &message))).await;
+                        break;
+                    }
+                    Err(err) => {
+                        let _ = relay
+                            .close(Some(close_frame(CloseCode::Error, &err.to_string())))
+                            .await;
+                        break;
+                    }
+                };
+                if result.is_err() {
+                    let _ = socket.close(1000, "");
+                    break;
+                }
+            }
+        }
+    }
+}
