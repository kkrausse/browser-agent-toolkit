diff --git a/codex-rs/exec-server/src/no_follow/wasi.rs b/codex-rs/exec-server/src/no_follow/wasi.rs
new file mode 100644
index 0000000..cb8bd9e
--- /dev/null
+++ b/codex-rs/exec-server/src/no_follow/wasi.rs
@@ -0,0 +1,58 @@
+//! wasm-term port: WASI has no `openat`-style API in std or rustix worth
+//! building a no-follow walk on, and the emulated machine's filesystem has no
+//! untrusted symlinks. Plain `std::fs`, run inline.
+use std::io;
+use std::io::Write;
+use std::path::Path;
+use std::path::PathBuf;
+
+pub(super) fn open_file_sync(path: &Path) -> io::Result<std::fs::File> {
+    let file = std::fs::File::open(path)?;
+    if !file.metadata()?.is_file() {
+        return Err(io::Error::new(
+            io::ErrorKind::InvalidInput,
+            "path is not a regular file",
+        ));
+    }
+    Ok(file)
+}
+
+pub(super) async fn write_file(path: PathBuf, contents: Vec<u8>) -> io::Result<()> {
+    let mut file = std::fs::OpenOptions::new()
+        .write(true)
+        .create(true)
+        .truncate(true)
+        .open(&path)?;
+    file.write_all(&contents)
+}
+
+pub(super) async fn metadata(path: PathBuf) -> io::Result<std::fs::Metadata> {
+    std::fs::symlink_metadata(&path)
+}
+
+pub(super) async fn create_directory(path: PathBuf, recursive: bool) -> io::Result<()> {
+    if recursive {
+        std::fs::create_dir_all(&path)
+    } else {
+        std::fs::create_dir(&path)
+    }
+}
+
+pub(super) async fn remove(path: PathBuf, recursive: bool, force: bool) -> io::Result<()> {
+    if recursive {
+        return Err(io::Error::new(
+            io::ErrorKind::Unsupported,
+            "recursive no-follow removal is unsupported",
+        ));
+    }
+    let metadata = match std::fs::symlink_metadata(&path) {
+        Ok(metadata) => metadata,
+        Err(error) if force && error.kind() == io::ErrorKind::NotFound => return Ok(()),
+        Err(error) => return Err(error),
+    };
+    if metadata.is_dir() {
+        std::fs::remove_dir(&path)
+    } else {
+        std::fs::remove_file(&path)
+    }
+}
