+
+// wasm-term: std has no file locks on WASI (`Unsupported`). The emulated machine runs
+// one process with one thread, so every lock is free and taking it is a no-op.
+#[cfg(not(target_os = "wasi"))]
+fn lock_file(file: &File) -> io::Result<()> {
+    file.lock()
+}
+
+#[cfg(target_os = "wasi")]
+fn lock_file(_file: &File) -> io::Result<()> {
+    Ok(())
+}
+
+#[cfg(not(target_os = "wasi"))]
+fn try_lock_file(file: &File) -> Result<(), std::fs::TryLockError> {
+    file.try_lock()
+}
+
+#[cfg(target_os = "wasi")]
+fn try_lock_file(_file: &File) -> Result<(), std::fs::TryLockError> {
+    Ok(())
+}
