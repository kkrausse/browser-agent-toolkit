+/// wasm-term: `exec` for a target without processes. The command runs on whatever
+/// `codex_utils_pty::backend` has installed (by default nothing: the spawn fails with
+/// the "no shell in this build" error); output, deltas, expiration and the exit code
+/// are handled as the native path does with a child process.
+#[cfg(target_os = "wasi")]
+mod wasi_exec {
+    use super::*;
+    use codex_utils_pty::SpawnedProcess;
+
+    fn delta(stream: &StdoutStream, is_stderr: bool, chunk: Vec<u8>) -> Event {
+        Event {
+            id: stream.sub_id.clone(),
+            msg: EventMsg::ExecCommandOutputDelta(ExecCommandOutputDeltaEvent {
+                call_id: stream.call_id.clone(),
+                stream: if is_stderr {
+                    ExecOutputStream::Stderr
+                } else {
+                    ExecOutputStream::Stdout
+                },
+                chunk,
+            }),
+        }
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    pub(super) async fn run(
+        program: &str,
+        args: &[String],
+        cwd: &AbsolutePathBuf,
+        env: &HashMap<String, String>,
+        arg0: &Option<String>,
+        expiration: ExecExpiration,
+        capture_policy: ExecCapturePolicy,
+        stdout_stream: Option<StdoutStream>,
+        after_spawn: Option<Box<dyn FnOnce() + Send>>,
+    ) -> Result<RawExecToolCallOutput> {
+        let spawned =
+            codex_utils_pty::spawn_pipe_process_no_stdin(program, args, cwd.as_path(), env, arg0, &[])
+                .await
+                .map_err(|err| {
+                    CodexErr::Io(io::Error::new(io::ErrorKind::Unsupported, err.to_string()))
+                })?;
+        if let Some(after_spawn) = after_spawn {
+            after_spawn();
+        }
+        let SpawnedProcess {
+            session,
+            mut stdout_rx,
+            mut stderr_rx,
+            mut exit_rx,
+        } = spawned;
+        let cap = capture_policy.retained_bytes_cap();
+        let mut stdout = Vec::new();
+        let mut stderr = Vec::new();
+        let mut deltas = 0usize;
+        let mut take = |buf: &mut Vec<u8>, is_stderr: bool, chunk: Vec<u8>| {
+            match cap {
+                Some(cap) => append_capped(buf, &chunk, cap),
+                None => buf.extend_from_slice(&chunk),
+            }
+            (deltas < MAX_EXEC_OUTPUT_DELTAS_PER_CALL)
+                .then(|| {
+                    deltas += 1;
+                    stdout_stream.as_ref().map(|stream| delta(stream, is_stderr, chunk))
+                })
+                .flatten()
+        };
+        let expiration_wait = async {
+            if capture_policy.uses_expiration() {
+                expiration.wait_with_outcome().await
+            } else {
+                std::future::pending::<ExecExpirationOutcome>().await
+            }
+        };
+        tokio::pin!(expiration_wait);
+        let (mut stdout_open, mut stderr_open) = (true, true);
+        let mut exit_code: Option<i32> = None;
+        let mut timed_out = false;
+        let mut stopped = false;
+        // Until the process has exited and both streams are closed (the backend closes
+        // them after its last byte), or the expiration fires.
+        while exit_code.is_none() || stdout_open || stderr_open {
+            let event = tokio::select! {
+                chunk = stdout_rx.recv(), if stdout_open => match chunk {
+                    Some(chunk) => take(&mut stdout, false, chunk),
+                    None => { stdout_open = false; None }
+                },
+                chunk = stderr_rx.recv(), if stderr_open => match chunk {
+                    Some(chunk) => take(&mut stderr, true, chunk),
+                    None => { stderr_open = false; None }
+                },
+                code = &mut exit_rx, if exit_code.is_none() => {
+                    exit_code = Some(code.unwrap_or(-1));
+                    None
+                },
+                outcome = &mut expiration_wait, if !stopped => {
+                    stopped = true;
+                    timed_out = matches!(outcome, ExecExpirationOutcome::TimedOut);
+                    // Killed, not waited for: whatever arrived so far is the output.
+                    session.terminate();
+                    break;
+                },
+            };
+            if let (Some(event), Some(stream)) = (event, stdout_stream.as_ref()) {
+                let _ = stream.tx_event.send(event).await;
+            }
+        }
+        let code = match (timed_out, stopped) {
+            (true, _) => EXIT_CODE_SIGNAL_BASE + TIMEOUT_CODE,
+            (false, true) => 1,
+            (false, false) => exit_code.unwrap_or(-1),
+        };
+        let stdout = StreamOutput { text: stdout, truncated_after_lines: None };
+        let stderr = StreamOutput { text: stderr, truncated_after_lines: None };
+        let aggregated_output = aggregate_output(&stdout, &stderr, cap);
+        Ok(RawExecToolCallOutput {
+            exit_status: ExitStatus::default(),
+            stdout,
+            stderr,
+            aggregated_output,
+            timed_out,
+            wasi_exit_code: Some(code),
+        })
+    }
+}
