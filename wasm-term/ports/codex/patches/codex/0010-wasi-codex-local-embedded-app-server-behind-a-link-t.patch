diff --git a/codex-rs/utils/pty/src/backend.rs b/codex-rs/utils/pty/src/backend.rs
new file mode 100644
index 0000000..9aa6b1a
--- /dev/null
+++ b/codex-rs/utils/pty/src/backend.rs
@@ -0,0 +1,109 @@
+//! wasm-term: the process seam.
+//!
+//! On WASI nothing can be spawned: there is no `fork`/`exec`, no pty and no
+//! pipe. Every place codex starts a command and collects its output ends in one
+//! of this crate's three spawn functions (`pty::spawn_process`,
+//! `pipe::spawn_process`, `pipe::spawn_process_no_stdin`); on WASI all three
+//! hand the request to the [`ProcessBackend`] installed here instead of the
+//! operating system. The default backend, [`NoShell`], refuses every request
+//! with an error the model can read. An emulated shell plugs in by
+//! implementing the trait and calling [`set_process_backend`] once at
+//! start-up, before the first turn.
+//!
+//! The contract (also in `wasm-term/ports/codex/NOTES.md`, "The spawn seam"):
+//!
+//! - A request is argv (`program` + `args`), the working directory, the
+//!   complete environment (nothing is inherited), an optional `arg0`, and how
+//!   stdio is wired: a pty of a given size, or pipes with stdin open or closed.
+//!   There is no timeout in the request; callers enforce their own and call
+//!   the terminator.
+//! - The backend answers at once with a [`ProcessDriver`]: a sender the caller
+//!   writes stdin bytes to, broadcast receivers the backend publishes stdout
+//!   and stderr chunks on (a pty has one stream: leave `stderr_rx` `None`), a
+//!   oneshot that resolves with the exit code, a `terminator` closure (kill
+//!   now; must lead to the exit code being sent), and for a pty a `resizer`.
+//! - The backend must drop its output senders when it has forwarded the last
+//!   byte: readers keep waiting for that after the exit code arrives.
+//! - `spawn` runs on the only thread, inside the tokio runtime. It must not
+//!   block; long work belongs in a task it spawns (`tokio::spawn` is fine).
+
+use std::collections::HashMap;
+use std::ffi::OsString;
+use std::io;
+use std::path::PathBuf;
+use std::sync::Arc;
+use std::sync::RwLock;
+
+use crate::ProcessDriver;
+use crate::SpawnedProcess;
+use crate::TerminalSize;
+use crate::spawn_from_driver;
+
+/// What the model is told when it asks for a command and no shell is installed.
+pub const NO_SHELL_MESSAGE: &str = "no shell in this build: codex is running inside a browser tab, where commands cannot be executed. \
+Do not retry; work with the file tools (apply_patch) or ask the user to run the command elsewhere.";
+
+/// How the process's standard streams are wired.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum ProcessStdio {
+    /// One terminal for stdin, stdout and stderr.
+    Pty { size: TerminalSize },
+    /// Separate stdout and stderr; `stdin` says whether stdin stays open for
+    /// writes (false: the process sees end-of-file at once).
+    Pipes { stdin: bool },
+}
+
+/// One command to run.
+#[derive(Debug, Clone)]
+pub struct ProcessSpawnRequest {
+    pub program: OsString,
+    pub args: Vec<String>,
+    pub cwd: PathBuf,
+    /// The whole environment of the process.
+    pub env: HashMap<String, String>,
+    /// `argv[0]`, when it differs from `program`.
+    pub arg0: Option<String>,
+    pub stdio: ProcessStdio,
+}
+
+pub trait ProcessBackend: Send + Sync + 'static {
+    fn spawn(&self, request: ProcessSpawnRequest) -> io::Result<ProcessDriver>;
+}
+
+/// The default backend: there is no shell.
+#[derive(Debug, Default, Clone, Copy)]
+pub struct NoShell;
+
+impl ProcessBackend for NoShell {
+    fn spawn(&self, _request: ProcessSpawnRequest) -> io::Result<ProcessDriver> {
+        Err(io::Error::new(io::ErrorKind::Unsupported, NO_SHELL_MESSAGE))
+    }
+}
+
+static BACKEND: RwLock<Option<Arc<dyn ProcessBackend>>> = RwLock::new(None);
+
+/// Installs the backend every later spawn goes to. Returns the previous one.
+pub fn set_process_backend(backend: Arc<dyn ProcessBackend>) -> Option<Arc<dyn ProcessBackend>> {
+    match BACKEND.write() {
+        Ok(mut slot) => slot.replace(backend),
+        Err(poisoned) => poisoned.into_inner().replace(backend),
+    }
+}
+
+/// The installed backend, or [`NoShell`].
+pub fn process_backend() -> Arc<dyn ProcessBackend> {
+    BACKEND
+        .read()
+        .ok()
+        .and_then(|slot| slot.clone())
+        .unwrap_or_else(|| Arc::new(NoShell))
+}
+
+/// Runs `request` on the installed backend and adapts the result to what the
+/// native spawn functions return.
+pub fn spawn_with_backend(request: ProcessSpawnRequest) -> anyhow::Result<SpawnedProcess> {
+    let driver = process_backend()
+        .spawn(request)
+        .map_err(|err| anyhow::anyhow!("{err}"))?;
+    Ok(spawn_from_driver(driver))
+}
