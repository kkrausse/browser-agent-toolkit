--- a/codex-rs/Cargo.toml
+++ b/codex-rs/Cargo.toml
@@ -657,6 +657,14 @@ inherits = "wasm"
 opt-level = "s"
 strip = true
 
+# wasm-term port: what the page ships. Whole-program LTO on top of wasm-small:
+# one codegen unit sees every crate, so duplicate generic instances and code
+# only reachable from the dropped embedded server go away. Slow to link.
+[profile.wasm-ship]
+inherits = "wasm-small"
+lto = "fat"
+codegen-units = 1
+
 [profile.ci-test]
 # Reduce binary size to reduce disk pressure.
 inherits = "test"
@@ -670,6 +678,8 @@ opt-level = 0
 # tokio = 1.52.3 + WASI stand-ins.
 crossterm = { path = "../../../guests/crossterm-wasi/crossterm" }
 tokio = { path = "../../tokio" }
+chrono = { path = "../../forks/chrono" }
+dirs = { path = "../../forks/dirs" }
 gethostname = { path = "../../forks/gethostname" }
 gix-fs = { path = "../../forks/gix-fs" }
 rustls-native-certs = { path = "../../forks/rustls-native-certs" }
