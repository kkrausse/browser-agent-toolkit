{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@random/ghostty-web": ["./node_modules/@random/ghostty-web/src/index.ts"]
    }
  },
  "include": ["*.ts", "../host/**/*.ts"]
}
